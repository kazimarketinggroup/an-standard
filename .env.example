# Supabase — from the dashboard: Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Browser-safe read key. Older projects call this NEXT_PUBLIC_SUPABASE_ANON_KEY;
# either name works — src/lib/supabase/env.ts reads whichever is set.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Server-only. Bypasses row level security, so it must never be exposed to the
# browser: it is read by server actions and the seed script only. Never prefix
# this with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
